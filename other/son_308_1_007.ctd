History  = # GEOMAR 01 wildedit - remove outliers using a sliding window
History  = # GEOMAR 01 wildedit parameters: 4.5 5 5 300 0
History  = # GEOMAR 01 wildedit vars: p
History  = # GEOMAR 01 wildedit parameters: 2 5 100 0
History  = # GEOMAR 01 wildedit vars: c_pri c_sec t_pri t_sec
History  = # GEOMAR 01 wildedit parameters: 2 5 100 0.2
History  = # GEOMAR 01 wildedit vars: o_pri o_sec
History  = # GEOMAR 01 filter - filter pressure sensor and interpolate missing data gaps
History  = # GEOMAR 01 filter parameters: 0.15 1/24 fillgaps
History  = # GEOMAR 01 filter vars: p
History  = # GEOMAR 01 celltm - correct conductivity cell thermal mass
History  = # GEOMAR 01 celltm parameters alpha_pri beta_pri  alpha_sec beta_sec : 0.03 7 0.03 7
History  = # GEOMAR 01 celltm vars: c_pri c_sec
History  = # GEOMAR 01 fix_sbe_times - determine a correct time vector
History  = # GEOMAR 02 get_sensors - collect sensor information and create calibration groups.
History  = # GEOMAR 03 fitsoak - determine pressure deckoffset and profile start
History  = # GEOMAR 04 applydeckoffset - remove pressure sensor deckoffset and flag pressure loops
History  = # GEOMAR 04 applydeckoffset parameters: w_min 0 m/s
History  = # GEOMAR 04 applydeckoffset - using primary density to flag pressure loops
History  = # GEOMAR 04 applydeckoffset - using secondary density to flag pressure loops
History  = # GEOMAR 04 applyhyst - correcting oxygen hysteresis, if it has not been done by datcnv
History  = # GEOMAR 05 align - align C and O with T by cross-correlation high-freq variability
History  = # GEOMAR 05 align parameters: pressure interval 600 to 800 dbar
History  = # GEOMAR 05 align parameters: T-C cross correlation sign 1
History  = # GEOMAR 05 align parameters: T-O cross correlation sign -1
History  = # GEOMAR 05 applied T-C timeshift to C
History  = # GEOMAR 05 applied T-O timeshift to O
History  = # GEOMAR 06 all_btl4down - create WOCE style equivalent down-cast bottle values
History  = # GEOMAR 07 merge_lab_values - merge salinometer and oxygen titration info with bottle data
History  = # GEOMAR 08 all_coeff - calculate calibration coefficients for conductivity and oxygen
History  = # GEOMAR 09 apply_calib - apply calibration coefficients to raw ctd data
History  = # GEOMAR 09 apply_calib2btl - apply calibration coefficients to bottle data
History  = # GEOMAR 09 nox_merging - merge calibrated nox data with CTD data
History  = # GEOMAR 10 d_ship - extract echosounder depths from ship data
History  = # GEOMAR 10 stationbook - extract ship station information from the ship's logbook
History  = # GEOMAR 10 get_times - extract WOCE style begin/bottom/end information
History  = # GEOMAR 10 station_list - create CTD station lists
History  = # GEOMAR 11 write_bottle_file - create bottle file with calibrated values
History  = # GEOMAR 11 write_calib_file - create final calibrated CTD data files
History  = # GEOMAR 11 write_calib_file  1dbar file is binned and linearly interpolated to full dbar
History  = # GEOMAR 11 write_calib_file  1sec file is binned
History  = # GEOMAR 11 write_calib_file  full file is at original temporal resolution
Comment  = p   is pressure            in dbar
Comment  = z   is depth               in m
Comment  = t   is in situ temperature in deg C (ITS-90)
Comment  = s   is salinity            in - (PSS-78)
Comment  = o   is dissolved oxygen    in umol/kg
Comment  = chl is calibrated chlorophyll         in ug/l
Comment  = chl_raw is DrHaardt fluorescence      in factory calibrated units or approx. mug/l
Comment  = chl2_raw is Wetlabs fluorescence      in factory calibrated units or approx. mug/l
Comment  = chl3_raw is Seapoint fluorescence     in factory calibrated units or approx. mug/l
Comment  = turb_raw is Wetlabs turbidity         in factory calibrated units / NTU
Comment  = turb2_raw is Seapoint turbidity       in factory calibrated units / FTU
Comment  = cdom_raw is Wetlabs CDOM fluorescence in factory calibrated units / mug/l
Comment  = cdom2_raw is Wetlabs Wetstar fluorescence in factory calibrated units / mug/l
Comment  = ss  is sound speed         in m/s
Comment  = sth is potential dens.-1000 in kg/m^3
Comment  = sig is in situ dens.-1000  in kg/m^3
Comment  = tim is time                in decimal days since 0000/01/01 (matlab datenum)
Comment  = lat is latitude            in decimal degrees North
Comment  = lon is longitude           in decimal degrees East
Comment  = par is PAR                 in umol/m^2/s
Comment  = spar is SPAR               in unknown units
Comment  = xmiss is transmissometer   in percent 
Comment  = bat is beam attenuation    in 1/m 
Comment  = voltage* is raw voltage    in Volts 
Comment  = nox_orig is internal SUNA/OPUS NOx   in umol/kg 
Comment  = nox is calibrated SUNA/OPUS NOx   in umol/kg 
Comment  = o_orig is uncalibrated dissolved oxygen    in umol/kg
Comment  = ox_sat is calibrated oxygen saturation   in % 
Comment  = not all of these variables have to be in this file!
